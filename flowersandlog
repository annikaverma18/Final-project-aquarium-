import turtle as painter


painter.pensize = 90
def make_sand_base(): 
  painter.penup()
  painter.goto(-300,-150)
  painter.pendown()
  painter.pencolor("LightGoldenrod1")
  painter.fillcolor("LightGoldenrod1")
  painter.begin_fill()
  painter.forward(600)
  painter.right(90)
  painter.forward(100)
  painter.right(90)
  painter.forward(600)
  painter.right(90)
  painter.forward(100)
  painter.end_fill()
make_sand_base()

def make_sand_details(): 
  painter.right(90)
  painter.right(90)
  painter.forward(20)
  painter.left(90)
  painter.pensize=10
  for details in range(12):
    painter.penup()
    painter.forward(20)
    painter.pencolor("tan2")
    painter.pensize=10
    painter.pendown()
    painter.forward(30)
    
def make_more_sand_details():
  painter.right(90)
  painter.forward(20)
  painter.right(90)
  for moredetails in range(12):
    painter.penup()
    painter.forward(20)
    painter.pencolor("tan2")
    painter.pensize=10
    painter.pendown()
    painter.forward(30)
  painter.left(90)
  painter.forward(20)
  painter.left(90)
  for evenmoredetails in range(12):
    painter.penup()
    painter.forward(20)
    painter.pencolor("tan2")
    painter.pensize=10
    painter.pendown()
    painter.forward(30)
  
make_sand_details()
make_more_sand_details()
painter.penup()
painter.goto(0,0)

wn = painter.Screen()
wn.setup(600,450)
wn.mainloop()
